+    pub(super) fn first_visible_source_line(&self) -> Option<DiffLinePosition> {
+        let run = self
+            .runs
+            .iter()
+            .filter(|run| run.visible.size.height > px(0.))
+            .min_by(|a, b| {
+                a.visible
+                    .top()
+                    .as_f32()
+                    .total_cmp(&b.visible.top().as_f32())
+                    .then_with(|| {
+                        (a.side != DiffSide::Modified).cmp(&(b.side != DiffSide::Modified))
+                    })
+            })?;
+        Some(DiffLinePosition::new(
+            run.document.path().clone(),
+            run.side,
+            run.document.line_number(run.side, run.line_ix),
+        ))
+    }
